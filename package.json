{
  "name": "chetna",
  "version": "3.2.14",
  "private": true,
  "_comment_overrides": "jwks-rsa@4 is CommonJS and does require('jose') at the top of src/utils.js, but it declares jose ^6 — and jose has been ESM-only since v5. npm hoists a single jose@6 (because @auth/core needs ^6), so at runtime firebase-admin's token verification dies with 'require() of ES Module ... not supported'. This pins a NESTED jose@4 (the last CommonJS line) for jwks-rsa only; jwks-rsa uses just importJWK and exportSPKI, both present in v4. @auth/core keeps the hoisted v6.",
  "overrides": {
    "jwks-rsa": {
      "jose": "^4.15.9"
    }
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "migrate:status": "dotenv -e .env.local -- prisma migrate status",
    "migrate:status:preview": "dotenv -e .env.preview -- prisma migrate status",
    "migrate:status:prod": "dotenv -e .env.prod -- prisma migrate status",
    "migrate:local": "dotenv -e .env.local -- prisma migrate deploy",
    "migrate:preview": "dotenv -e .env.preview -- prisma migrate deploy",
    "migrate:prod": "dotenv -e .env.prod -- prisma migrate deploy",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "verify:payments": "dotenv -e .env.local -e .env -- node scripts/verify-payment-webhook.mjs",
    "verify:payouts": "dotenv -e .env.local -- tsx scripts/verify-payouts.mts",
    "photo:astrologer": "node scripts/import-astrologer-photo.mjs",
    "seed:ai": "dotenv -e .env.local -- node scripts/seed-ai-astrologers.mjs",
    "seed:ai:preview": "dotenv -e .env.preview -- node scripts/seed-ai-astrologers.mjs",
    "seed:ai:prod": "dotenv -e .env.prod -- node scripts/seed-ai-astrologers.mjs",
    "release": "npm version patch --no-git-tag-version && node scripts/show-release.mjs",
    "release:minor": "npm version minor --no-git-tag-version && node scripts/show-release.mjs",
    "release:major": "npm version major --no-git-tag-version && node scripts/show-release.mjs",
    "apple:secret": "node scripts/generate-apple-secret.mjs",
    "assets:build": "node scripts/build-app-assets.mjs",
    "assets": "node scripts/build-app-assets.mjs && capacitor-assets generate --ios --android --assetPath mobile/assets --androidProject mobile/android --iosProject mobile/ios/App",
    "shell:prepare": "node scripts/prepare-shell.mjs",
    "cap:sync": "node scripts/prepare-shell.mjs && cap sync && node scripts/fix-spm-paths.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky",
    "console": "node scripts/ops-console/server.mjs"
  },
  "dependencies": {
