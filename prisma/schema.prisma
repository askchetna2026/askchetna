// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User model for authentication
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String? // Null for OAuth users
  name            String?
  image           String? // Profile picture from OAuth
  emailVerified   DateTime?
  // Phone sign-in (native apps). Nullable because the vast majority of
  // existing accounts are email/Google only; email stays the required
  // identity so nothing downstream (newsletter, reports, lifecycle mail)
  // has to cope with a null address. Stored E.164, e.g. "+919876543210".
  phone           String?   @unique
  phoneVerifiedAt DateTime?

  /// Account deletion, required in-app by BOTH App Store guideline 5.1.1(v) and
  /// Google Play's data-deletion policy.
  ///
  /// Soft delete with a grace period: requesting deletion sets these, signs the
  /// user out, and locks the account to a cancellation screen only. A cron then
  /// purges permanently after deletionScheduledFor.
  ///
  /// Both stores permit scheduled deletion; what they reject is an account that
  /// remains usable afterwards, since that is deactivation rather than deletion.
  deletionRequestedAt  DateTime?
  deletionScheduledFor DateTime?

  welcomeBonusNotifiedAt DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  isSubscribed           Boolean   @default(true) // For Newsletter
  whatsappOptIn          Boolean   @default(false) // Opt-in for WhatsApp notifications

  profiles               Profile[]
  questions              Question[]
  creditPacks            CreditPack[]
  journalEntries         JournalEntry[]
  dailyInsights          DailyInsight[]
  accounts               Account[]
  sessions               Session[]
  exports                ExportRecord[]
  creditHistory          CreditTransaction[]
  creditRequests         CreditRequest[]
  topics                 Topic[]
  posts                  Post[]
  profileLimits          UserProfileLimit[]
  lifecycleEmails        LifecycleEmail[]
  deviceTokens           DeviceToken[]
  astrologer             Astrologer?
  consultations          Consultation[]
  consultationMemories   ConsultationMemory[]
  consultationRatings    ConsultationRating[]
  appointments           Appointment[]
  astrologerApplications AstrologerApplication[]

  /// Lets the purge cron find due accounts without scanning the whole table.
  @@index([deletionScheduledFor])
}

/// Push notification registration for one install of the native app.
///
/// Keyed on the FCM token rather than the user: a token identifies a specific
/// app install, and the same device can be handed to a different account
/// (sign out, sign in as someone else). Registration therefore upserts on
/// `token` and reassigns `userId`, so a notification can never be delivered to
/// the previous owner of the device.
model DeviceToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token       String  @unique
  platform    String // "ios" | "android"
  appVersion  String?
  deviceModel String?

  /// Refreshed each time the app registers, so stale installs can be pruned.
  lastSeenAt DateTime @default(now())

  /// Set when the user opts out, signs out, or FCM reports the token as
  /// unregistered. Rows are disabled rather than deleted to keep delivery
  /// history meaningful.
  disabledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, disabledAt])
}

// OAuth account info (for NextAuth)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Session for NextAuth
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Birth chart profile
model Profile {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name         String
  dateOfBirth  DateTime
  timeOfBirth  String // Stored as "HH:MM" format
  placeOfBirth String
  latitude     Float
  longitude    Float
  timezone     String
  gender       String   @default("other") // Mandatory field: "male", "female", or "other"

  chartData      Json? // Complete calculated chart positions
  report         Report?
  isActive       Boolean   @default(true) // Whether this profile is active
  unlockedCharts Json? // Array of unlocked chart keys e.g. ["D2", "D10"]
  disabledAt     DateTime? // When this profile was disabled
  disabledReason String? // Why it was disabled (e.g., "Overwritten by newer version")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([userId, isActive])
}

model Report {
  id        String   @id @default(cuid())
  profileId String   @unique
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  status    String   @default("pending") // pending, purchased, generated
  content   Json? // Cached AI report content
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// AI Clarity questions
model Question {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  questionText  String
  response      Json // 6-section AI answer structure
  chartSnapshot Json // Chart data at time of question

  isPaid    Boolean @default(false)
  paymentId String? // Razorpay payment ID
  amount    Int? // Amount in paise

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// Credit packs purchased
model CreditPack {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  packType       String // "5_PACK" or "10_PACK"
  questionsTotal Int // 5 or 10
  questionsUsed  Int    @default(0)

  purchasedAt DateTime  @default(now())
  expiresAt   DateTime? // Null = never expires

  paymentId String // Razorpay payment ID
  amount    Int // Amount paid in paise

  @@index([userId])
}

// Verification tokens for email verification
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Daily reflections
model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  date      String // Using "YYYY-MM-DD" format
  transit   Json? // Optional: capture transit data for that day
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
}

/// The AI-written "how today reads for you" note on the logged-in home.
///
/// Exists so the model is called ONCE per user per calendar day. The browser
/// caches the text in localStorage for instant display, but localStorage cannot
/// be the authority: a second device, another browser, a private window or a
/// cleared cache would each buy another generation. The unique key below is
/// what actually holds the spend to one call.
///
/// `date` is the SEEKER'S local calendar day as "YYYY-MM-DD", sent by the
/// client — matching JournalEntry, and for the same reason. Deriving it from
/// server time would roll the day over mid-evening for users east of UTC, which
/// is most of this audience.
model DailyInsight {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date    String /// "YYYY-MM-DD" in the seeker's own timezone
  content Json /// { headline, body, focus, caution }

  /// What it was generated from, so a stale note is recognisable rather than
  /// merely wrong: the profile it used and the dasha lord current at the time.
  profileId String?
  dashaLord String?

  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

// Dynamic Pricing Configuration
model PricingPlan {
  id          String  @id @default(cuid())
  key         String  @unique // e.g. "SINGLE_QUESTION", "CREDIT_PACK_5"
  name        String
  description String?
  price       Int // Amount in paise (e.g. 14900 for ₹149)
  currency    String  @default("INR")
  credits     Int     @default(0) // Number of credits this plan gives (0 for n/a)
  isActive    Boolean @default(true)

  /// App Store product identifier for this pack, e.g.
  /// "com.askchetnam.app.credits_10". Set only for plans purchasable on iOS,
  /// where Apple requires In-App Purchase instead of Razorpay.
  ///
  /// An explicit column rather than deriving the product id from `key` by
  /// convention: the mapping is what turns a completed Apple payment into
  /// credits, and a silent convention mismatch would take the customer's money
  /// and grant nothing. Being a DB column also means it is editable from the
  /// existing pricing admin without a deploy.
  ///
  /// NOTE: iOS prices come from Apple's price tiers in the App Store, NOT from
  /// `price` above, which stays the INR/Razorpay figure for web and Android.
  appleProductId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Service Credit Configuration
model ServiceCost {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "ASK_QUESTION"
  description String?
  credits     Int      @default(1) // Number of credits this action costs
  updatedAt   DateTime @updatedAt
}

// Analytics Tracking
model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String // PAGE_VIEW, FEATURE_USE
  path      String?
  userId    String? // Optional, for logged-out users
  visitorId String?
  country   String?
  city      String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type])
  @@index([type, createdAt])
  @@index([visitorId])
}

// Admin Newsletters
model Newsletter {
  id              String   @id @default(cuid())
  subject         String
  content         String   @db.Text
  recipientsCount Int
  sentAt          DateTime @default(now())
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  isSubscribed   Boolean   @default(true)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isSubscribed])
}

// Export Records
model ExportRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chartType String // e.g. "D1", "D9"
  url       String // URL to download
  createdAt DateTime @default(now())

  @@index([userId])
}

// Credit Usage History
model CreditTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int // Negative for usage, positive for adding
  description String // e.g. "Unlocked D9 Chart", "Purchased 5 Credits"
  createdAt   DateTime @default(now())
  metadata    Json? // Optional extra info

  @@index([userId])
}

model CreditRequest {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedCredits Int
  reason           String?   @db.Text
  status           String    @default("PENDING")
  adminNote        String?   @db.Text
  reviewedBy       String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
}

model Topic {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Post {
  id        String   @id @default(cuid())
  content   String   @db.Text
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([topicId])
  @@index([userId])
}

model BlogPost {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// User Profile Limit for extra profile slots
model UserProfileLimit {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  extraSlots  Int      @default(0) // Number of purchased additional slots
  purchasedAt DateTime @default(now())

  @@index([userId])
}

model LifecycleEmail {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignKey String
  dedupeKey   String    @unique
  subject     String
  status      String    @default("pending")
  metadata    Json?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, campaignKey])
  @@index([campaignKey, createdAt])
}

model LifecycleAutomationRun {
  id          String   @id @default(cuid())
  batchKey    String
  campaignKey String
  triggerType String
  status      String   @default("completed")
  attempted   Int      @default(0)
  sent        Int      @default(0)
  skipped     Int      @default(0)
  failed      Int      @default(0)
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([campaignKey, createdAt])
  @@index([triggerType, createdAt])
  @@index([batchKey])
}

// ═══════════════════════════════════════════════════════════════════════════
// Astrologer marketplace
// ═══════════════════════════════════════════════════════════════════════════

/// Admin-only numeric configuration.
///
/// Separate from ServiceCost, whose `credits` field means "this action costs N
/// credits". These values are seconds, percentages and paise, and storing them
/// in a column named `credits` would be a lie that outlives whoever wrote it.
///
/// Enforcement of "admin only" lives in the API layer — the schema cannot
/// express it. Every write path must check the admin role.
model AppSetting {
  key         String   @id
  value       Int
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@map("app_settings")
}

/// A user who has registered to take consultations.
///
/// One per user, and deliberately a separate record rather than a role flag:
/// astrologers carry payout, verification and rate data that has no meaning for
/// an ordinary account, and an approval workflow that a boolean cannot express.
model Astrologer {
  id     String  @id @default(cuid())
  /// Null for an AI persona, which has no account to sign in with. Postgres
  /// permits many NULLs under a unique index, so @unique still holds one
  /// profile per real user.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// An AI persona rather than a person.
  ///
  /// Modelled as a flag on Astrologer rather than a separate table so AI
  /// astrologers inherit the directory, availability, consultation, billing and
  /// admin surfaces already built. A parallel model would have meant a second
  /// implementation of every one of those.
  ///
  /// Must be disclosed in the UI wherever one appears — both stores treat an
  /// undisclosed AI persona presented as a person as deceptive.
  isAI Boolean @default(false)

  /// Persona and expertise, injected as the system prompt. Only meaningful when
  /// isAI. Editable from the admin console so a persona can be tuned without a
  /// deploy.
  aiSystemPrompt String? @db.Text

  /// Optional provider/model override, e.g. "openai:gpt-4o". Null uses the
  /// default for the consultation flow.
  aiModel String?

  displayName String
  bio         String?  @db.Text
  /// Where the published portrait is SERVED from — always the pointer route
  /// `/api/astrologers/<id>/photo`, never a signed URL, which would be dead
  /// within the hour while the profile stayed live.
  photoUrl    String?
  /// Where the published portrait actually LIVES, as an object path in the
  /// private bucket.
  ///
  /// Separate from the application's `profilePhotoPath` on purpose. The
  /// application is the record of what an admin reviewed and must stay as
  /// submitted; this is the photo currently published, which the astrologer may
  /// replace whenever they like. Null means fall back to the application, which
  /// is what every profile approved before this column keeps doing — so no
  /// backfill is needed.
  photoPath   String?
  languages    String[] // ISO codes, e.g. ["hi","en"]
  specialities String[] // e.g. ["career","relationships"]

  /// PENDING | APPROVED | SUSPENDED | REJECTED. Only APPROVED may take sessions.
  status          String    @default("PENDING")
  approvedAt      DateTime?
  approvedBy      String?
  rejectionReason String?   @db.Text

  /// Per-astrologer override of ASTROLOGER_REVENUE_PCT. Null means use the
  /// global default, so changing the default moves everyone who has no override.
  revenueSharePct Int?

  /// What one block of this astrologer's time costs, in credits. Null means the
  /// global default (1), so raising the default moves everyone without an
  /// override — same rule as revenueSharePct.
  ///
  /// Snapshotted onto Consultation when a session opens and never joined live:
  /// repricing an astrologer must not silently rewrite the cost of sessions
  /// already billed.
  creditsPerBlock Int?

  /// Manual online toggle, and a heartbeat. Availability needs both: a toggle
  /// alone leaves ghosts online after a crash.
  isAvailable Boolean   @default(false)
  lastSeenAt  DateTime?

  /// Payout destination. Nullable because it is collected after approval, not
  /// at registration. See the tax note in the plan before extending this.
  payoutAccountRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consultations Consultation[]
  memories      ConsultationMemory[]
  ratings       ConsultationRating[]
  earnings      AstrologerEarning[]
  payouts       Payout[]
  availability  AstrologerAvailability[]
  appointments  Appointment[]

  @@index([status, isAvailable])
  @@map("astrologers")
}

/// One consultation session, billed in whole blocks.
///
/// A block is bought up front — one credit opens `secondsPerBlock` seconds. When
/// a block is nearly spent the user may buy another; if they do not, the SERVER
/// closes the session at `deadlineAt`. Nothing here is fractional, which is what
/// lets the existing whole-credit model stand unchanged.
///
/// Rates and shares are SNAPSHOTTED, never joined live. An astrologer's rate
/// will change, and a live join would silently rewrite every historical earning
/// and break reconciliation against payouts already made.
model Consultation {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  astrologerId String
  astrologer   Astrologer @relation(fields: [astrologerId], references: [id])

  /// CHAT | AUDIO | VIDEO. Present from day one so adding a mode is a config
  /// row and a transport adapter, not a second billing path.
  kind String @default("CHAT")

  /// REQUESTED | ACTIVE | ENDED_BY_USER | ENDED_BY_ASTROLOGER
  /// ENDED_NO_EXTENSION | ENDED_TIMEOUT | FAILED
  status String @default("REQUESTED")

  startedAt DateTime?
  endedAt   DateTime?

  /// Server-authoritative end of the currently paid block. The client counts
  /// down toward it for display only; the server decides when time is up.
  deadlineAt DateTime?

  blocksCharged  Int @default(0)
  creditsCharged Int @default(0)
  billedSeconds  Int @default(0)

  // ---- snapshots taken when the session opens ----
  secondsPerBlock  Int
  creditValuePaise Int
  revenueSharePct  Int
  /// Credits per block at the moment this session opened. Defaults to 1, which
  /// is what every consultation billed before per-astrologer pricing existed —
  /// so historical rows keep their real cost rather than inheriting a new rate.
  creditsPerBlock  Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ConsultationMessage[]
  earning  AstrologerEarning?
  rating   ConsultationRating?

  @@index([userId, createdAt])
  @@index([astrologerId, createdAt])
  @@index([status])
  /// Lets the sweeper find sessions whose deadline has passed without needing a
  /// full scan — the safety net for clients that never send an end event.
  @@index([status, deadlineAt])
  @@map("consultations")
}

model ConsultationMessage {
  id             String       @id @default(cuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  senderId       String
  body           String       @db.Text
  sentAt         DateTime     @default(now())
  readAt         DateTime?

  @@index([consultationId, sentAt])
  @@map("consultation_messages")
}

/// What an astrologer remembers about a seeker, between sessions.
///
/// A ROLLING SUMMARY, deliberately not a transcript. Continuity could have been
/// built by replaying prior sessions into the prompt, and that is the version
/// that does not survive contact with a real user: the reply flow already
/// slices to the last 20 messages precisely because context cannot grow without
/// bound, and every prior session carried verbatim would be re-read, and paid
/// for, on every single turn forever. A few hundred words rewritten after each
/// session is a fixed cost that still remembers.
///
/// It is also what makes "start a new conversation" mean something. The choice
/// on offer is a clean transcript, not amnesia — the astrologer still knows who
/// you are, which is the whole reason to come back to the same one.
///
/// Unique on (userId, astrologerId): memory belongs to the PAIRING. Two
/// astrologers who have both spoken to the same seeker know different things
/// about them, which is true of people and should be true here.
///
/// Applies to human astrologers as well as AI personas. A human reading a
/// summary of what was discussed six weeks ago is the same feature — the only
/// difference is that they read it rather than being prompted with it.
model ConsultationMemory {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  astrologerId String
  astrologer   Astrologer @relation(fields: [astrologerId], references: [id], onDelete: Cascade)

  /// Rewritten after each session from the previous summary plus that
  /// session's transcript. Never appended to — appending is how a summary
  /// becomes a transcript again.
  summary String @db.Text

  sessionCount  Int       @default(0)
  lastSessionAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, astrologerId])
  @@index([astrologerId, updatedAt])
  @@map("consultation_memories")
}

/// What a seeker thought of one consultation.
///
/// Unique on consultationId, which is the whole integrity model here: a rating
/// belongs to a SESSION, so it can only be given by someone who had that
/// session, and only once. Ratings detached from a session are the ones that
/// can be manufactured.
///
/// Feedback is capped in words rather than characters because that is what was
/// asked for and what a reader actually experiences — 50 words is a paragraph,
/// 300 characters is a number nobody can picture.
model ConsultationRating {
  id             String       @id @default(cuid())
  consultationId String       @unique
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  astrologerId String
  astrologer   Astrologer @relation(fields: [astrologerId], references: [id], onDelete: Cascade)

  /// 1 to 5. Enforced by the route as well — a check constraint here would not
  /// give the caller a usable error.
  stars Int

  /// Optional: a rating without words is still a rating, and demanding prose
  /// is how you get "good" fifty times.
  feedback String? @db.Text

  createdAt DateTime @default(now())

  /// Serves the astrologer's card: newest feedback first, and the aggregate.
  @@index([astrologerId, createdAt])
  @@map("consultation_ratings")
}

/// Append-only earnings ledger, one row per consultation.
///
/// Payout totals are summed from here and never recomputed from consultations:
/// recomputation drifts the moment a rate or share percentage changes, and a
/// figure that moves after it has been paid is unauditable.
///
/// The unique constraint on consultationId is the idempotency guard — settling
/// the same session twice is a duplicate key error rather than double pay.
model AstrologerEarning {
  id             String       @id @default(cuid())
  astrologerId   String
  astrologer     Astrologer   @relation(fields: [astrologerId], references: [id])
  consultationId String       @unique
  consultation   Consultation @relation(fields: [consultationId], references: [id])

  creditsServed Int
  amountPaise   Int

  /// Null until a payout run claims it. This is what makes runs re-runnable.
  payoutId String?
  payout   Payout? @relation(fields: [payoutId], references: [id])

  createdAt DateTime @default(now())

  @@index([astrologerId, createdAt])
  @@index([payoutId])
  @@map("astrologer_earnings")
}

model Payout {
  id           String     @id @default(cuid())
  astrologerId String
  astrologer   Astrologer @relation(fields: [astrologerId], references: [id])

  periodStart DateTime
  periodEnd   DateTime

  creditsServed Int
  amountPaise   Int

  /// PENDING | PROCESSING | PAID | FAILED
  status    String    @default("PENDING")
  reference String? // bank or RazorpayX payout id
  notes     String?   @db.Text
  paidAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  earnings AstrologerEarning[]

  @@index([astrologerId, periodEnd])
  @@index([status])
  @@map("payouts")
}

/// A first-screening application to become an astrologer.
///
/// Deliberately SEPARATE from `Astrologer`, per §28 of the implementation spec:
/// submitting an application must never create a public profile. `Astrologer` is
/// the approved, published record; this is the thing an admin reviews. Keeping
/// them apart means an application can be rejected, amended, or sit in review
/// for weeks without any of that touching the directory.
///
/// Multi-select answers are stored as String[] rather than join tables: they are
/// closed vocabularies read as a whole and never queried across applicants, so a
/// relational table would add joins without buying anything.
model AstrologerApplication {
  id     String @id @default(cuid())
  /// Human-quotable identifier shown on the confirmation screen, e.g. AC-7F3A9C21.
  /// Support conversations need something a person can read down a phone line.
  ref    String @unique
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// DRAFT | SUBMITTED | UNDER_REVIEW | REQUEST_MORE_INFORMATION
  /// APPLICANT_RESPONDED | SHORTLISTED | VERIFICATION_PENDING | VERIFIED
  /// FINAL_APPROVAL | REJECTED | ACTIVE
  status String @default("SUBMITTED")

  // ---- Section 1: about you ----
  fullName         String
  displayName      String
  email            String
  phone            String
  country          String
  city             String
  /// Storage path, not a URL. Photos stay private until a profile is published
  /// (spec §30), so they are served through short-lived signed URLs generated
  /// per request rather than a permanent public link.
  profilePhotoPath String?

  // ---- Section 2: practice ----
  primaryPractice        String
  primaryPracticeOther   String?
  additionalPractices    String[]
  yearsOfExperience      String
  learningMethods        String[]
  learningMethodOther    String?
  teacherGuruInstitute   String?
  hasFormalQualification Boolean  @default(false)
  qualificationName      String?

  // ---- Section 3: expertise ----
  areasOfExpertise      String[]
  areasOfExpertiseOther String?
  specialization        String?  @db.Text

  // ---- Section 4: languages and methods ----
  languages             String[]
  languageOther         String?
  consultationMethods   String[]
  availabilityFrequency String

  // ---- Section 5: previous experience ----
  previousConsultationExperience String
  previousConsultationLocations  String[]
  professionalProfileUrl         String?

  // ---- Section 6-8: screening answers ----
  aboutYou                     String  @db.Text
  consultationApproach         String  @db.Text
  sensitiveQuestionsApproach   String  @db.Text
  whyJoinAskchetna             String  @db.Text
  predictionCommunication      String
  predictionCommunicationOther String? @db.Text

  // ---- Section 9: declarations ----
  // Stored individually rather than as one flag: they are separate consents and
  // an audit needs to show which was given, not merely that a box was ticked.
  declarationAccuracy               Boolean   @default(false)
  declarationNoGuarantee            Boolean   @default(false)
  declarationTerms                  Boolean   @default(false)
  declarationAdditionalVerification Boolean   @default(false)
  declaredAt                        DateTime?

  // ---- review ----
  submittedAt     DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  reviewedAt      DateTime?
  reviewedBy      String?
  /// Never shown to the applicant. Spec §25: internal notes stay internal.
  adminNotes      String?   @db.Text
  /// Shown to the applicant, so it must be written for them to read.
  rejectionReason String?   @db.Text
  /// What the admin has asked the applicant to supply, when status is
  /// REQUEST_MORE_INFORMATION.
  infoRequest     String?   @db.Text
  infoRequestedAt DateTime?

  @@index([status, submittedAt])
  @@index([userId])
  @@map("astrologer_applications")
}

// ═══════════════════════════════════════════════════════════════════════════
// Appointments
// ═══════════════════════════════════════════════════════════════════════════

/// A recurring weekly window in which an astrologer will take booked sessions.
///
/// Authored in the astrologer's OWN local time and stored as a zone name rather
/// than an offset. An offset would be wrong twice a year in any country that
/// observes DST, and wrong permanently if the astrologer relocates — the window
/// means "my Tuesday evening", not "+05:30 on Tuesday".
///
/// Minutes-from-local-midnight rather than a DateTime: this repeats forever and
/// has no date. Storing a date would invite reading it as one.
model AstrologerAvailability {
  id           String     @id @default(cuid())
  astrologerId String
  astrologer   Astrologer @relation(fields: [astrologerId], references: [id], onDelete: Cascade)

  /// 0 = Sunday, matching JavaScript's getDay().
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  /// IANA zone, e.g. "Asia/Kolkata".
  timezone    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([astrologerId, dayOfWeek])
  @@map("astrologer_availability")
}

/// A session booked for a future time.
///
/// Deliberately SEPARATE from Consultation. A Consultation is a session that is
/// happening — it has messages, billing and an earning. An Appointment is a
/// promise about a time, and most of its life is spent before any of that
/// exists. Collapsing them would mean every consultation query had to filter
/// out sessions that had not started.
///
/// Credits are taken at CONFIRMED, not at request and not at start: the moment
/// both sides have agreed is the moment the astrologer's time stops being
/// available to anyone else, so that is what the seeker is paying to hold.
model Appointment {
  id  String @id @default(cuid())
  /// Human-quotable, e.g. AP-3F9A21. Support conversations need something a
  /// person can read down a phone line.
  ref String @unique

  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  astrologerId String
  astrologer   Astrologer @relation(fields: [astrologerId], references: [id])

  /// Always UTC. Rendered in each party's own zone at the edges.
  startAt DateTime
  blocks  Int      @default(1)

  /// REQUESTED | COUNTERED | CONFIRMED | CANCELLED | COMPLETED | NO_SHOW | EXPIRED
  status String @default("REQUESTED")

  /// The astrologer's alternative, when they counter rather than accept. The
  /// seeker either takes it — which moves startAt here and confirms — or lets
  /// it lapse.
  counterAt   DateTime?
  counterNote String?   @db.Text

  /// SNAPSHOTTED at confirmation, exactly as Consultation does it. An
  /// astrologer's rate will change, and a live join would silently reprice an
  /// appointment somebody has already paid for.
  secondsPerBlock Int?
  creditsPerBlock Int?
  creditsCharged  Int  @default(0)

  /// Set when the session actually opens, which is what links a promise to the
  /// thing that fulfilled it.
  consultationId String? @unique

  /// One flag per reminder so a retry, or a scheduler that fires twice, cannot
  /// send the same notice again.
  remindedDayBefore  Boolean @default(false)
  remindedHourBefore Boolean @default(false)

  cancelledAt  DateTime?
  /// SEEKER | ASTROLOGER | SYSTEM
  cancelledBy  String?
  cancelReason String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Two people cannot hold the same astrologer at the same instant. Enforced
  /// in the database because two confirmations racing is exactly the case an
  /// application-level check loses.
  @@unique([astrologerId, startAt])
  @@index([astrologerId, status, startAt])
  @@index([userId, startAt])
  @@index([status, startAt])
  @@map("appointments")
}
